# --- Database ---
# Local dev: sqlite:///./data/app.db
# Hosted (Neon/Supabase): postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./data/app.db

# --- LLM (Groq — free tier, no card required) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings (local, no key needed) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma_store

# --- App ---
CORS_ORIGINS=http://localhost:5173
QUESTIONS_PER_INTERVIEW=6
RETRIEVAL_TOP_K=4
