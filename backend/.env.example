# --- Database ---
# Local dev: sqlite:///./data/app.db
# Hosted (Neon/Supabase): postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./data/app.db

# --- LLM (Groq — free tier, no card required) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# --- Embeddings (fastembed, local, no key needed, no torch) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Precomputed vector store (see scripts/precompute_embeddings.py) ---
PRECOMPUTED_DIR=./data/precomputed

# --- App ---
CORS_ORIGINS=http://localhost:5173
QUESTIONS_PER_INTERVIEW=6
RETRIEVAL_TOP_K=4
